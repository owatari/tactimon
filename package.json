{
  "name": "tactimon",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @tactimon/client dev",
    "music": "pnpm --filter @tactimon/client prepare:music",
    "build": "pnpm -r build",
    "test": "vitest run tests && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e:walkthrough": "vitest run --config tools/e2e/vitest.config.ts walkthrough",
    "e2e:playthrough": "vitest run --config tools/e2e/vitest.config.ts playthrough"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
